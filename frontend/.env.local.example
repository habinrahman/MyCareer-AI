# Marketing site (logo link in shared Header). Production example:
# NEXT_PUBLIC_MAIN_SITE_URL=https://www.microdegree.work
NEXT_PUBLIC_MAIN_SITE_URL=https://www.microdegree.work

# Optional: override default `/microdegree-logo.png` in /public (e.g. `/microdegree-logo.svg`)
# NEXT_PUBLIC_APP_LOGO_SRC=/microdegree-logo.svg

# FastAPI base (no trailing slash). Do not set to empty — the browser would POST to Next.js and you will see CORS/404 errors.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# V1 public MVP (matches backend flags)
NEXT_PUBLIC_ENABLE_AUTH=false
NEXT_PUBLIC_ENABLE_CHAT=false
NEXT_PUBLIC_ENABLE_BENCHMARKING=false
NEXT_PUBLIC_ENABLE_JOB_MATCHING=false
NEXT_PUBLIC_ENABLE_RECRUITER_MODE=false
NEXT_PUBLIC_ENABLE_WORKSPACE=false
NEXT_PUBLIC_ENABLE_REPORTS=false
NEXT_PUBLIC_PUBLIC_RESUME_REVIEW=true

# Full product (example)
# NEXT_PUBLIC_ENABLE_AUTH=true
# NEXT_PUBLIC_ENABLE_CHAT=true
# NEXT_PUBLIC_ENABLE_BENCHMARKING=true
# NEXT_PUBLIC_ENABLE_JOB_MATCHING=true
# NEXT_PUBLIC_ENABLE_RECRUITER_MODE=true
# NEXT_PUBLIC_ENABLE_WORKSPACE=true
# NEXT_PUBLIC_ENABLE_REPORTS=true
# NEXT_PUBLIC_PUBLIC_RESUME_REVIEW=false
