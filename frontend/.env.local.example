# MicroDegree Resume Intelligence — single public tool
NEXT_PUBLIC_MAIN_SITE_URL=https://www.microdegree.work
# NEXT_PUBLIC_APP_LOGO_SRC=/microdegree-logo.svg

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
