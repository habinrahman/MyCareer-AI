NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Marketing site origin for Header logo (no trailing path required)
NEXT_PUBLIC_MAIN_SITE_URL=https://www.microdegree.work
# NEXT_PUBLIC_APP_LOGO_SRC=/microdegree-logo.svg

# FastAPI base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Copy to .env.local for local dev (see .env.local.example for V1 feature flags).

# Supabase Dashboard → Authentication → URL configuration:
# - Site URL: http://localhost:3000 (or your deployed origin)
# - Additional Redirect URLs: http://localhost:3000/auth/callback
#   (production: https://your-domain/auth/callback)
